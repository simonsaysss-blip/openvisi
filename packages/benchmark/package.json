{
  "name": "@openvisi/benchmark",
  "version": "0.1.0",
  "description": "Flat-file benchmark harness for reproducible OpenVisi AI Visibility benchmarks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simonsaysss-blip/openvisi.git",
    "directory": "packages/benchmark"
  },
  "keywords": [
    "ai-visibility",
    "llm-search",
    "benchmark",
    "cli"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --dts --clean --external package.json"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
